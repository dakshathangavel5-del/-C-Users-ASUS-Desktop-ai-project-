# ==============================================================================
# Environment Configuration Template for Lost and Found Matcher
# CIT AI-Native Engineering Programme - Semester 1 - Assessment 5
# ==============================================================================

# API Provider Selection: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (or course Week 12 API key)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, generic LLM API Key:
LLM_API_KEY=your_api_key_here

# OpenAI API Key (optional, if using OpenAI endpoints)
OPENAI_API_KEY=your_openai_api_key_here

# Target LLM Model Name
LLM_MODEL=gemini-1.5-flash

